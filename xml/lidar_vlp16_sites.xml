<?xml version="1.0" encoding="utf-8"?>
<!--
  Velodyne VLP-16 Puck lidar sites.

  Spec:
    Channels:            16
    Vertical FoV:        30° (+15° to -15°), 2° step
    Horizontal FoV:      360°, 0.2° step → 1800 rays per ring
    Total sensors:       16 × 1800 = 28,800

  Quaternion per layer: θ = 90° − e, quat = [cos(θ/2), 0, sin(θ/2), 0]
  (pure R_y rotation, tilts site -Z to point radially outward at elevation e)

  Include inside a <body> in worldbody:
    <body name="lidar_body" pos="...">
      <geom .../>
      <include file="lidar_vlp16_sites.xml"/>
    </body>
-->
<mujoco>
  <!-- l00: e=-15° -->
  <replicate sep="-"  count="50" euler="0 0 18.0">
    <site name="vlp16_l00" pos="0 0 0" quat="0.60876 0 0.79335 0"/>
  </replicate>

