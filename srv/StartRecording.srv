# StartRecording.srv — begin a recording episode
#
# Request
string output_dir        # Parent directory.  A sub-directory is created here.
string format            # "hdf5" (default) | "mcap" | "lerobot" | "both" |
                         # "hdf5_and_mcap"  | "hdf5_and_lerobot"
                         # Leave empty to use the default (hdf5).
int32  episode_index     # Hint for the episode index.  The recorder will use
                         # max(episode_index, total_committed_episodes) so that
                         # data is never overwritten across sessions.
string task_description  # Human-readable task label stored in metadata.
---
# Response
bool   success
string message
string actual_path        # Full path of the episode directory being written
int32  actual_episode_index  # Actual episode index used (may be > episode_index)
