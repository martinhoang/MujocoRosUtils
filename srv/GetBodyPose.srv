string body_name          # MuJoCo body name to query
---
bool    success
string  message
# World-frame pose (from d->xpos / d->xquat, updated after mj_kinematics)
float64 pos_x
float64 pos_y
float64 pos_z
float64 rot_qw            # quaternion: w x y z
float64 rot_qx
float64 rot_qy
float64 rot_qz
# World-frame velocity (from d->cvel, updated after mj_kinematics)
#   angular [0..2] = angular velocity (rad/s) in world frame
#   linear  [3..5] = linear  velocity (m/s)   in world frame
float64 angular_vel_x
float64 angular_vel_y
float64 angular_vel_z
float64 linear_vel_x
float64 linear_vel_y
float64 linear_vel_z
string  parent_body       # name of the parent body
bool    is_dynamic        # true if the body has a freejoint (i.e. moves via qpos)
